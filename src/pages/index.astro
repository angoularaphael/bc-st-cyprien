<body data-page="home">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ============================ HERO ============================ *
         La composition tient en TROIS étages, pas en deux colonnes qui se
         disputent la hauteur : (1) l’accroche pleine largeur — un seul point
         d’entrée pour l'œil ; (2) la ligne de front, où la parole et la photo
         partent du MÊME trait horizontal ; (3) la barre de chiffres, qui fait
         la marche vers la suite. L’ancienne version empilait titre + texte +
         badges + boutons dans une colonne de près de mille pixels, et la grille
         centrait la photo au milieu de ce vide : d’où l’image « posée dessous ».
         Ici la photo ne peut plus glisser — elle commence là où la parole
         commence. -->
    <header class="hero" aria-label="Boxing Center Saint-Cyprien">
      <!-- LA SALLE EN FOND. Photo reelle, pas un decor : c'est ce que
           le visiteur verra en poussant la porte. Voile bleu nuit
           par-dessus — un voile noir grisait la photo, le bleu la fait
           entrer dans l'identite du club. -->
      <img class="hero__bg" src="/assets/img/sc/hero-salle.webp"
           alt="Le plateau Boxing Center Saint-Cyprien : la ligne de sacs, le ring bleu au centre, la cage et les tapis"
           width="1647" height="955" fetchpriority="high" decoding="async" />

      <div class="wrap hero__inner">
        <h1 class="hero__lockup" data-reveal>
          <span class="hero__category">Club de boxe à Toulouse</span>
          <img class="hero__logo" src="/assets/img/logo-white.webp" alt="Boxing Center"
               width="384" height="179" fetchpriority="high" />
          <span class="hero__salle">Saint-Cyprien</span>
        </h1>

        <!-- L'accroche dit A QUI c'est, pas ce qu'on ressentira. -->
        <p class="hero__claim" data-reveal>Débutants · Loisir · Compétition</p>

        <p class="hero__sub" data-reveal>Boxe anglaise, K1, Muay Thaï, cross-training et préparation physique.<br />Un club ouvert 6 j/7, pour tous les niveaux.</p>

        <div class="hero__cta" data-reveal>
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29"><span>Voir l’offre Rentrée — 29€</span></a>
          <a class="btn" href="#configurateur"><span>Découvrir les cours</span></a>
        </div>
      </div>

      <!-- LES TROIS REPERES. Ils repondent aux trois questions muettes :
           ou c'est, quand je peux venir, est-ce que c'est pour moi. -->
      <div class="hero__foot">
      <ul class="hero__facts" data-reveal>
        <li class="hfact">
          <svg class="hfact__i" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.6"/></svg>
          <span><b>11 rue Sainte-Lucie</b>Toulouse — Saint-Cyprien</span>
        </li>
        <li class="hfact">
          <svg class="hfact__i" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.6" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5.3l3.4 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><b>Ouvert 6 j/7</b>Lundi au samedi, cours sans réservation</span>
        </li>
        <li class="hfact">
          <svg class="hfact__i" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="9" cy="8.4" r="3.1" stroke="currentColor" stroke-width="1.6"/><path d="M3.6 19.4c0-3 2.4-5.2 5.4-5.2s5.4 2.2 5.4 5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16.2 6.2a3 3 0 0 1 0 5.9M17.6 14.6c2.1.5 3.6 2.3 3.6 4.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <span><b>Débutants bienvenus</b>Coachs diplômés, gants prêtés</span>
        </li>
      </ul>

      <a class="hero__scroll" href="#configurateur">
        <span class="hero__scroll-m" aria-hidden="true"></span>
        Découvrir la salle
      </a>
      </div>
    </header>

    <!-- ========================= TICKER =========================== -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track" id="marquee"></div>
    </div>

    <!-- ==================== MANIFESTO — une ligne ================== -->
    <section class="manifesto band-light" aria-label="Le manifeste">
      <div class="wrap">
        <p><span class="reveal-mask"><span>La cinquième salle du réseau.</span></span><span class="reveal-mask"><span class="tint">La première en centre-ville.</span></span></p>
      </div>
    </section>

    <!-- ================= LE CONFIGURATEUR (signature) ============== -->
    <section class="config" id="configurateur" aria-label="Choisir sa discipline">
      <div class="config__bg" id="config-bg" aria-hidden="true"></div>
      <div class="wrap config__grid">
        <div>
          <span class="eyebrow" data-reveal>Le configurateur</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(2.2rem,5vw,4.2rem)"><span class="reveal-mask"><span>Quelle discipline</span></span><span class="reveal-mask"><span class="tint">pour toi ?</span></span></h2>
          <p data-reveal style="max-width:42ch;margin-top:.9rem;color:var(--ink-soft)">Passe la liste : les jours et le niveau s’affichent. Première fois ? Dis-le au coach du créneau, il s’occupe de toi.</p>
          <div class="config__list" id="config-list" role="tablist" aria-orientation="vertical" aria-label="Les disciplines"></div>
        </div>
        <div class="config__panel" id="config-panel" role="tabpanel" aria-labelledby="cfg-anglaise" aria-live="polite" data-reveal>
          <div class="config__media" id="config-media"></div>
          <div class="config__body" id="config-body"></div>
        </div>
      </div>
    </section>

    <!-- ============== LE CADRAN DES OFFRES (roulette.js) =============
         Posé ici : le configurateur : la discipline est choisie, reste le prix. Le module remplit `[data-roulette]` ; sans
         JavaScript, il n'y a rien — donc rien de cassé. -->
    <div class="rdial-band">
      <div class="wrap"><div data-roulette></div></div>
    </div>


    <!-- ===================== TEASER COACHS ======================== -->
    <section class="section coachrow" aria-label="L’encadrement">
      <div class="wrap">
        <div class="coachrow__head" data-reveal>
          <span class="eyebrow">L’encadrement</span>
          <h2 class="display coachrow__title"><span class="reveal-mask"><span>Les coachs</span></span><span class="reveal-mask"><span class="tint">qui t’encadrent.</span></span></h2>
          <p class="coachrow__lead" data-reveal>Même toit, même adresse. Dadi à l’anglaise, la Lady Punch et l’école ; Tawee au pieds-poings, Brice au moteur.</p>
        </div>
        <div class="coachrow__grid" id="coachrow" data-reveal-group></div>
        <a class="btn coachrow__more" data-magnetic href="/coachs/"><span>Voir les coachs</span></a>
      </div>
    </section>

    <!-- ================== CARTE ESSAI — 10€ seule ================= -->
    <!-- ======================= LA SEMAINE ============================
         Cuite dans le HTML (les moteurs la lisent sans JavaScript) ; home.js
         marque aujourd’hui et le prochain cours, à l’heure de Paris. -->
    <section class="section semaine" id="semaine" aria-labelledby="t-semaine">
      <div class="wrap">
        <span class="eyebrow" data-reveal>Au planning</span>
        <h2 id="t-semaine" class="display" style="margin-top:1rem;font-size:clamp(2.2rem,5vw,4.2rem)"><span class="reveal-mask"><span>Cette semaine</span></span><span class="reveal-mask"><span class="tint">à Saint-Cyprien.</span></span></h2>
        <p class="lead" data-reveal style="max-width:60ch">Du lundi au samedi, de 10h00 à 21h30 : {SCHEDULE.length} cours encadrés par semaine, sans réservation. Entre deux, la salle reste ouverte en accès libre.</p>
        <p class="semaine__live mono" id="semaine-live" aria-live="polite" hidden></p>
        <ol class="semaine__jours">
          {SEMAINE.map((j) => (
            <li class="semaine__jour" data-day={j.d}>
              <h3 class="semaine__nom mono">{j.long}</h3>
              <ul>{j.cours.map((c) => (<li data-start={c.start}><time>{c.start}</time><span>{c.cours}</span><em>{c.lvl}</em></li>))}</ul>
            </li>
          ))}
        </ol>
        <p class="semaine__plus mono"><a href="/plannings/">Le planning complet, discipline par discipline →</a></p>
      </div>
    </section>

    <section class="section essai-sec" aria-label="La séance d’essai">
      <div class="wrap">
        <div class="essai" data-reveal>
          <div class="essai__spot" aria-hidden="true"></div>
          <div class="essai__body">
            <span class="eyebrow">L’offre de rentrée</span>
            <h2 class="display essai__title"><span class="reveal-mask"><span>29€ toutes les quatre semaines,</span></span><span class="reveal-mask"><span class="tint">sans engagement.</span></span></h2>
            <p class="lead essai__lead">Cours illimités, toutes disciplines de la salle, sans engagement — au lieu de <s class="was">44,99€</s>. Tu viens avec ton binôme si tu veux : chacun sa place, chacun ses gants.</p>
