<!doctype html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <script>
    /* VERROU — cette page est un GESTE de l'assistant, pas une adresse publique.
       Sans le laissez-passer depose par le chatbot au moment ou il l'offre
       (meme session, 30 minutes), on sert la 404 : personne ne « tombe »
       sur la seance offerte en tapant l'URL. */
    (function () {
      try {
        var t = +(sessionStorage.getItem("bcs-offert-pass") || 0);
        if (!t || Date.now() - t > 30 * 60 * 1000) location.replace("/404.html");
      } catch (e) { location.replace("/404.html"); }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ta séance offerte | Boxing Center Saint-Cyprien</title>
  <meta name="description" content="Sur invitation de l’assistant du club : ta première séance au Boxing Center Saint-Cyprien est offerte." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=b18" />
  <link rel="stylesheet" href="/assets/css/base.css?v=41" />
  <style>
    .off-wrap { max-width: 720px; margin: 0 auto; padding: clamp(5rem,10vw,7rem) 20px 4rem; }
    .off-kick { font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; opacity: .65; }
    .off-h1 { font-size: clamp(2rem,6vw,3.2rem); line-height: 1.05; margin: .6rem 0 1rem; }
    .off-lead { opacity: .85; line-height: 1.6; max-width: 54ch; margin-bottom: 2rem; }
    .off-form { display: grid; gap: .9rem; }
    .off-row { display: grid; gap: .9rem; grid-template-columns: 1fr 1fr; }
    @media (max-width: 620px) { .off-row { grid-template-columns: 1fr; } }
    .off-field { display: grid; gap: .35rem; font-size: .8rem; letter-spacing: .04em; }
    .off-field input, .off-field select { background: rgba(255,255,255,.05); border: 1px solid rgba(174,188,207,.25);
      border-radius: 10px; padding: .8rem 1rem; color: inherit; font: inherit; font-size: 16px; }
    .off-consent { display: flex; gap: .6em; align-items: flex-start; font-size: .82rem; line-height: 1.45; opacity: .9; }
    .off-btn { margin-top: .4rem; background: linear-gradient(145deg,#2b5fd4,#4a8fe8); color: #fff; border: 0;
      border-radius: 12px; padding: 1rem 1.4rem; font: inherit; font-weight: 700; cursor: pointer; }
    .off-btn[disabled] { opacity: .6; cursor: wait; }
    .off-status { min-height: 1.4em; font-size: .88rem; }
  </style>
</head>
<body data-page="seance-offerte">
  <main class="off-wrap">
    <p class="off-kick">Sur invitation</p>
    <h1 class="off-h1">Ta séance est offerte.</h1>
    <p class="off-lead">C’est l’assistant du club qui t’ouvre cette porte : ta première séance rive gauche est pour nous. Laisse-nous de quoi te joindre, Dadi ou l’un des coachs t’appelle pour choisir ton créneau et confirmer ce qu’il faut apporter.</p>
    <form class="off-form" id="off-form" novalidate>
      <div class="off-row">
        <label class="off-field"><span>Ton prénom *</span><input type="text" name="first_name" required autocomplete="given-name" /></label>
        <label class="off-field"><span>Ton nom *</span><input type="text" name="last_name" required autocomplete="family-name" /></label>
      </div>
      <div class="off-row">
        <label class="off-field"><span>Email *</span><input type="email" name="email" required autocomplete="email" /></label>
        <label class="off-field"><span>Téléphone *</span><input type="tel" name="phone" required autocomplete="tel" /></label>
      </div>
      <div class="off-row">
        <label class="off-field"><span>C’est pour qui ? *</span>
          <select name="pour_qui" required>
            <option value="Pour moi" selected>Pour moi</option>
            <option value="Pour mon enfant">Pour mon enfant</option>
            <option value="Pour nous deux">Pour nous deux (parent + enfant)</option>
          </select></label>
        <label class="off-field"><span>La discipline qui te tente</span>
          <select name="discipline">
            <option value="" selected>Je ne sais pas encore — conseillez-moi</option>
            <option>Boxe Anglaise</option>
            <option>Boxe Thaï / K1</option>
            <option>Grappling</option>
            <option>Boxing Camp</option>
            <option>Lady Punch</option>
            <option>HYROX / Cross-Training</option>
            <option>Boxe Pieds-Poings</option>
            <option>Baby Boxe (3–6 ans)</option>
            <option>Boxe Éducative (7–16 ans)</option>
          </select></label>
      </div>
      <div class="off-row">
        <label class="off-field"><span>Tes disponibilités</span><input type="text" name="disponibilites" placeholder="ex. les soirs en semaine…" /></label>
        <label class="off-field"><span>Comment nous as-tu connus ?</span>
          <select name="source_connaissance">
            <option value="" disabled selected>Choisis…</option>
            <option>L’assistant du site</option>
            <option>Instagram / Facebook</option>
            <option>Google</option>
            <option>Le bouche-à-oreille</option>
            <option>Autre</option>
          </select></label>
      </div>
      <label class="off-consent"><input type="checkbox" name="consentement" value="oui" required style="margin-top:.25em" />
        <span>J’accepte que le Boxing Center me contacte pour organiser ma séance et me tenir au courant de ses offres. *</span></label>
      <input type="hidden" name="salle" value="Saint-Cyprien" />
      <input type="hidden" name="offre" value="Séance d’essai offerte — invitation de l’assistant" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
      <button class="off-btn" type="submit">Je réserve ma séance offerte</button>
      <p class="off-status" id="off-status" role="status" aria-live="polite"></p>
    </form>
    <p style="margin-top:2rem;font-size:.82rem;opacity:.6">Boxing Center Saint-Cyprien — 11 rue Sainte-Lucie, 31300 Toulouse · <a href="tel:+33562244682" style="color:inherit">05 62 24 46 82</a> · lun–sam 10h–21h30</p>
  </main>
  <script type="module">
    /* Le cadeau du bot — même protocole que Portet : preuve de travail + pot
       de miel vers Inlett (email automatique, ID branché dès réception), et
       TOUJOURS la base commune via /api/lead (gestion-manager, champ salle). */
    const INLETT_URL = "https://inlett.vercel.app";
    const INLETT_ESSAI_FORM_ID = ""; // ← ID à coller dès qu’Eddy crée le formulaire Saint-Cyprien
    const form = document.getElementById("off-form");
    /* Préremplissage : ce que le visiteur a déjà confié à l'assistant (même
       session) — zéro re-saisie, la règle du réseau. */
    try {
      const p = JSON.parse(sessionStorage.getItem("bcs-chat-profil") || "{}");
      const fill = (n, v) => { const i = form.querySelector(`[name="${n}"]`); if (i && !i.value && v) i.value = v; };
      fill("first_name", p.prenom || "");
      fill("last_name", p.nom || "");
      fill("email", p.email || "");
      fill("phone", p.phone || p.tel || "");
    } catch { /* pas de profil : formulaire vierge */ }
    const status = document.getElementById("off-status");
    const sha256 = async (s) => [...new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s)))].map((b) => b.toString(16).padStart(2, "0")).join("");
    async function pow(challenge, difficulty) {
      const prefix = "0".repeat(difficulty);
      for (let nonce = 0; ; nonce++) {
        if ((await sha256(`${challenge}:${nonce}`)).startsWith(prefix)) return String(nonce);
        if (nonce % 2000 === 1999) await new Promise((r) => setTimeout(r));
      }
    }
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const btn = form.querySelector(".off-btn");
      btn.disabled = true;
      status.textContent = "Réservation en cours…";
      const fd = new FormData(form);
      const payload = { _lang: "fr" };
      fd.forEach((v, k) => (payload[k] = String(v)));
      try {
        if (INLETT_ESSAI_FORM_ID) {
          const ch = await (await fetch(`${INLETT_URL}/api/challenge`)).json();
          payload.pow_challenge = ch.challenge;
          payload.pow_timestamp = String(ch.timestamp);
          payload.pow_nonce = await pow(ch.challenge, ch.difficulty);
          const r = await fetch(`${INLETT_URL}/api/submit/${INLETT_ESSAI_FORM_ID}`, {
            method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
          });
          if (!r.ok) throw new Error("inlett");
        }
        await fetch("/api/lead", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            event: "essai_offert_form",
            prenom: payload.first_name, nom: payload.last_name,
            name: `${payload.first_name} ${payload.last_name}`.trim(),
            email: payload.email, phone: payload.phone, salle: "Saint-Cyprien",
            message: `Discipline : ${payload.discipline || "à conseiller"} · Pour qui : ${payload.pour_qui} · Dispos : ${payload.disponibilites || "-"} · Connu via : ${payload.source_connaissance || "-"}`,
            page: location.pathname,
          }),
        });
        form.reset();
        status.textContent = "C’est réservé ! Un coach t’appelle très vite pour caler ton créneau. 🥊";
      } catch {
        status.textContent = "L’envoi n’est pas passé. Réessaie dans un instant, ou appelle le 05 62 24 46 82.";
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
