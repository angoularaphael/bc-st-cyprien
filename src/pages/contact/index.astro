    <!-- ========================= EN-TÊTE ========================== -->
    <header class="phero" aria-label="Contact & accès">
      <img class="phero__bg" src="/assets/img/sc/salle-1.webp" alt="Le plateau vu dans sa longueur" loading="eager" decoding="async" />
      <div class="phero__spot" aria-hidden="true"></div>
      <div class="wrap">
        <p class="eyebrow" data-reveal style="margin-top:1.1rem">Contact · 11 rue Sainte-Lucie</p>
        <h1 class="display"><span class="reveal-mask"><span>Boxing Center Saint-Cyprien —</span></span><span class="reveal-mask"><span class="tint">adresse et horaires.</span></span></h1>
        <p class="lead" data-reveal>Près du tram T1 Fer à Cheval, sur la rive gauche. Appelle, on décroche — et on te répond avant le prochain cours.</p>
        <div class="phero-cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/offre/29"><span>Voir l’offre Rentrée — 29€</span></a>
          <a class="btn" data-magnetic href="tel:+33562244682"><span>05 62 24 46 82</span></a>
        </div>
        <div class="phero__mark" aria-hidden="true"></div>
      </div>
    </header>

    <section class="section contact-answer" aria-labelledby="avant-venir">
      <div class="wrap">
        <span class="eyebrow">Avant de partir</span>
        <h2 class="display contact-answer__title" id="avant-venir">Venir sans deviner.</h2>
        <div class="contact-answer__grid">
          <article>
            <h3>Accès</h3>
            <p>11 rue Sainte-Lucie, 31300 Toulouse. L’arrêt de tram Fer à Cheval (T1) est à 200&nbsp;m, 3&nbsp;minutes à pied&nbsp;; la station de métro Saint-Cyprien – République (ligne A) à 600&nbsp;m, 8&nbsp;minutes.</p>
          </article>
          <article>
            <h3>Accueil</h3>
            <p>La salle est ouverte du lundi au samedi, de 10h00 à 21h30. Le dimanche, elle est fermée.</p>
          </article>
          <article>
            <h3>Première séance</h3>
            <p>Arrive dix minutes avant, en tenue de sport, et dis que c’est ta première fois. Gants et matériel sont prêtés sur place. Une question avant de venir&nbsp;? <a href="tel:+33562244682">05 62 24 46 82</a>.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ==================== COORDONNÉES + CARTE ================== -->
    <section class="section contact-sec" aria-label="Coordonnées et carte">
      <div class="wrap contact-grid">
        <div data-reveal>
          <span class="eyebrow">Nous trouver</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(1.8rem,4vw,2.7rem)">11 rue Sainte-Lucie.</h2>
          <ul class="coords" id="coords"></ul>
          <div class="hours">
            <span class="hours__k">Horaires</span>
            <ul class="hours__list" id="hours"></ul>
          </div>
          <div class="rating" id="rating" aria-label="Avis Google actuels"></div>
        </div>
        <div class="cmap-wrap" data-reveal>
          <iframe class="cmap" title="Carte — Boxing Center Saint-Cyprien, 11 rue Sainte-Lucie, 31300 Toulouse" src="https://www.google.com/maps?q=11%20rue%20Sainte-Lucie%2031300%20Toulouse&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <!-- La carte est ramenée dans le noir par un filtre (invert/hue) qui vire le pin rouge Google au cyan.
               On repose donc un vrai repère spark au centre (= l’adresse interrogée) pour que le « tu es ici » soit sans ambiguïté. -->
          <span class="cmap-pin" aria-hidden="true"></span>
          <a class="cmap-link" href="https://maps.google.com/?q=11+rue+Sainte-Lucie+31300+Toulouse" target="_blank" rel="noopener">Ouvrir l’itinéraire ↗</a>
        </div>
      </div>
    </section>

    <!-- ============== LE CADRAN DES OFFRES (roulette.js) =============
         Posé ici : coordonnées vues, avant la FAQ. Le module remplit `[data-roulette]` ; sans
         JavaScript, il n'y a rien — donc rien de cassé. -->
    <div class="rdial-band">
      <div class="wrap"><div data-roulette></div></div>
    </div>


    <!-- ========================= LA FAQ ========================== -->
    <section class="section" style="padding-top:0" aria-label="Questions fréquentes">
      <div class="wrap">
        <div data-reveal style="margin-bottom:clamp(1.6rem,4vw,2.4rem)">
          <span class="eyebrow">Avant de venir</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(1.9rem,4.4vw,3rem)"><span class="reveal-mask"><span>Les questions</span></span><span class="reveal-mask"><span class="tint">qu’on nous pose.</span></span></h2>
        </div>
        <div class="faq" id="faq"></div>
        <!-- La FAQ donne les informations essentielles et renvoie au club
             pour confirmer le créneau et le matériel selon la discipline. -->
        <div style="margin-top:clamp(1.4rem,3vw,2rem)" data-reveal>
          <a class="btn" data-magnetic href="/activites/"><span>Voir les activités</span></a>
        </div>
      </div>
    </section>

    <!-- ========================= FINAL CTA ======================== -->
    <section class="gong" aria-label="Réserver une séance">
      <span class="gong__mark" aria-hidden="true"><b>Boxing Center</b><i>Saint-Cyprien</i></span>
      <div class="gong__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>Près du tram T1</span>
        <h2 class="display" style="font-size:clamp(2rem,5vw,3.6rem)"><span class="reveal-mask"><span>Le trajet est court.</span></span><span class="reveal-mask"><span class="tint">Le premier pas aussi.</span></span></h2>
        <p class="lead" data-reveal>Tram T1 Fer à Cheval à 200 m, porte ouverte du lundi au samedi. Dix euros pour venir voir.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/seance-essai"><span>Réserver ma 1<sup>re</sup> séance</span></a>
          <a class="btn" data-magnetic href="tel:+33562244682"><span>05 62 24 46 82</span></a>
        </div>
      </div>
    </section>

  </main>

