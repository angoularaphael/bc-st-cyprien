<body data-page="plannings">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ========================= EN-TÊTE ========================== -->
    <header class="phero" aria-label="Le planning">
      <img class="phero__bg" src="/assets/img/sc/sacs-alignes.webp" alt="La ligne de sacs suspendus à la charpente" loading="eager" decoding="async" />
      <div class="phero__spot" aria-hidden="true"></div>
      <div class="wrap">
        <p class="eyebrow" data-reveal id="pl-season" style="margin-top:1.1rem">Saison 2026 — 2027 · Rive gauche</p>
        <h1 class="display"><span class="reveal-mask"><span>Le planning</span></span><span class="reveal-mask"><span class="tint">de la semaine.</span></span></h1>
        <div class="phero__mark" aria-hidden="true"></div>
      </div>
    </header>

    <!-- ==================== FILTRES + GRILLE ====================== -->
    <section class="section pl-wrap" aria-label="La grille des cours">
      <div class="wrap">
        <div data-reveal style="margin-bottom:clamp(1.4rem,3vw,2rem)">
          <span class="eyebrow">La grille</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(1.8rem,4vw,2.8rem)">Ta semaine, réglée.</h2>
        </div>
        <div class="pl-pulse" id="pl-pulse" data-reveal-group aria-label="La semaine en chiffres"></div>
        <div class="filters" id="filters" role="group" aria-label="Filtrer le planning"></div>
        <div class="pl-bar">
          <p class="pl-count" id="pl-count" role="status" aria-live="polite"></p>
          <button class="pl-reset" id="pl-reset" type="button" hidden>Tout réafficher</button>
        </div>
        <div class="pgrid" id="grid"></div>
        <p class="pl-empty" id="pl-empty" hidden>Aucun cours ne correspond à ces trois filtres réunis. <button class="pl-empty__reset" type="button">Repars de la semaine entière</button></p>
      </div>
    </section>

    <!-- ============== LE CADRAN DES OFFRES (roulette.js) =============
         Posé ici : le créneau est repéré, on enchaîne sur l’offre. Le module remplit `[data-roulette]` ; sans
         JavaScript, il n'y a rien — donc rien de cassé. -->
    <div class="rdial-band">
      <div class="wrap"><div data-roulette></div></div>
    </div>


