<body data-page="coachs">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ========================= EN-TÊTE ========================== -->
    <header class="phero" aria-label="Les coachs">
      <img class="phero__bg" src="/assets/img/sc/coachs-header.webp" alt="Un coach en casquette et sweat Boxing Center tient le sac de frappe pendant qu'une pratiquante travaille ses coups" loading="eager" fetchpriority="high" decoding="async" />
      <div class="phero__spot" aria-hidden="true"></div>
      <div class="wrap">
        <p class="eyebrow" data-reveal style="margin-top:1.1rem">L’encadrement · trois coachs</p>
        <h1 class="display"><span class="reveal-mask"><span>Coachs de boxe</span></span><span class="reveal-mask"><span class="tint">à Saint-Cyprien.</span></span></h1>
        <div class="phero__mark" aria-hidden="true"></div>
      </div>
    </header>

    <section class="section coach-answer" aria-labelledby="quel-coach">
      <div class="wrap coach-answer__grid">
        <div>
          <span class="eyebrow">Une réponse directe</span>
          <h2 class="display coach-answer__title" id="quel-coach">Quel coach pour quelle discipline&nbsp;?</h2>
        </div>
        <div class="coach-answer__copy">
          <p><strong>Dadi</strong> enseigne la boxe anglaise, la Lady Punch et l’école enfants. <strong>Tawee</strong> intervient en boxe thaï et K1. <strong>Brice</strong> accompagne l’Hyrox, le cross-training et le Boxing Camp.</p>
          <p>Le grappling figure bien au planning, mais aucun encadrant n’est nommé dans le planning officiel&nbsp;: demande confirmation à la salle plutôt que de choisir sur une information supposée.</p>
          <div class="coach-answer__links">
            <a class="btn" href="/plannings/"><span>Comparer les créneaux</span></a>
            <a class="btn btn--ghost" href="tel:+33562244682"><span>Appeler le 05 62 24 46 82</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================== L’ÉQUIPE ========================== -->
    <section class="section roster-sec" aria-label="L’équipe">
      <div class="wrap">
        <div class="roster-sec__head" data-reveal>
          <span class="eyebrow">L’équipe</span>
          <h2 class="display roster-sec__title">Nos <span class="tint">coachs.</span></h2>
          <p class="roster-sec__lead">Un visage, ce qu’il enseigne, et le planning de sa discipline.</p>
        </div>
        <div class="roster" id="roster"></div>
      </div>
    </section>

    <!-- ============== LE CADRAN DES OFFRES (roulette.js) =============
         Posé ici : l’encadrement a convaincu, on donne le prix. Le module remplit `[data-roulette]` ; sans
         JavaScript, il n'y a rien — donc rien de cassé. -->
    <div class="rdial-band">
      <div class="wrap"><div data-roulette></div></div>
    </div>


    <!-- ========================= FINAL CTA ======================== -->
    <section class="gong" aria-label="Réserver une séance">
      <span class="gong__mark" aria-hidden="true"><b>Boxing Center</b><i>Saint-Cyprien</i></span>
      <div class="gong__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>Le meilleur moyen de les connaître</span>
        <h2 class="display" style="font-size:clamp(2rem,5vw,3.6rem)"><span class="reveal-mask"><span>Monte sur le ring</span></span><span class="reveal-mask"><span class="tint">avec eux.</span></span></h2>
        <p class="lead" data-reveal>Une séance suffit pour savoir qui te corrige et comment. Dix euros, toutes disciplines.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/offre/29"><span>Voir l’offre Rentrée — 29€</span></a><a class="btn btn--ghost" data-magnetic href="https://boutique.boxingcenter.fr/seance-essai?utm_source=site&utm_medium=cta&utm_campaign=st-cyprien"><span>Essayer une séance · 10€</span></a>
          <a class="btn" data-magnetic href="/plannings/"><span>Voir le planning</span></a>
        </div>
      </div>
    </section>

  </main>

