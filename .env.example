# ─────────────────────────────────────────────────────────────
# Boxing Center — variables d'environnement (Vercel → Settings → Environment Variables)
# TOUTES sont optionnelles : sans elles le site fonctionne, en mode dégradé honnête.
# Copie ce fichier en .env pour du local. NE COMMITE JAMAIS .env.
# ─────────────────────────────────────────────────────────────

# ── Le backoffice « Le vestiaire » (/admin/) ──
# Le mot de passe du staff. Sans lui, l'admin refuse toute connexion.
ADMIN_TOKEN=

# ── L'assistant (chatbot IA) ──
# Au moins UNE clé pour des réponses IA. Sans aucune, l'assistant répond
# quand même via sa base locale ancrée (jamais de bulle vide).
# GEMINI est lu en POOL : tu peux ajouter GEMINI_API_KEY_2, _3, … pour répartir le quota.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
MISTRAL_API_KEY=
# Temps maximal accordé à un fournisseur avant repli local (millisecondes).
CHAT_PROVIDER_TIMEOUT_MS=6500

# ── Les contacts collectés par l'assistant ET par les dépôts de la galerie ──
# Un seul carnet pour les deux : l'assistant envoie event="lead_collected",
# un dépôt sur le mur du club envoie event="upload_contributor". Le vestiaire
# les relit au même endroit, avec l'origine affichée en clair.
# Option A — le registre relisible dans le vestiaire (recommandé) :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option B — un e-mail au staff à chaque contact :
RESEND_API_KEY=
LEAD_EMAIL_TO=boxingcenter31@gmail.com
LEAD_EMAIL_FROM=
# (LEAD_TO / LEAD_FROM restent acceptés : d'anciens déploiements les utilisent.)
# Option C — un webhook (Make, Zapier, n8n…) :
LEAD_WEBHOOK_URL=
# Sans aucune option, les contacts sont journalisés dans les logs Vercel (rien n'est perdu).

# ── LA GALERIE DU CLUB (dépôts des visiteurs sur /galerie/) ──
# UNE seule variable suffit. Elle se copie telle quelle depuis le tableau de
# bord Cloudinary (Dashboard → API Environment variable). Cloudinary sert de
# stockage, de transcodage, de base (les tags "pending"/"approved") et de
# modération. Non renseignée ⇒ la section reste visible mais annonce
# honnêtement que le mur ouvre bientôt ; rien ne casse.
CLOUDINARY_URL=
# Le dossier de CETTE salle — une salle, un dossier, jamais de mélange.
COMMUNITY_FOLDER=bc-st-cyprien-community
# Les garde-fous (le serveur décide, le navigateur ne fait qu'afficher) :
COMMUNITY_MAX_IMAGE_MO=12
COMMUNITY_MAX_VIDEO_MO=80
COMMUNITY_MAX_DUREE_SEC=15
# Anti-spam : nombre d'envois autorisés par IP et par fenêtre.
COMMUNITY_RATE_WINDOW_MIN=15
COMMUNITY_RATE_MAX=4
# Le coup d'œil automatique sur les images en attente réutilise LE MÊME POOL
# GEMINI que l'assistant (GEMINI_API_KEY, GEMINI_API_KEY_2, _3, … : toutes les
# variables qui commencent par GEMINI_API_KEY sont ramassées, mélangées, et les
# clés à quota épuisé sont sautées). Sans aucune clé : pas de pré-tri, tout part
# en file de modération humaine — c'est le staff qui juge, et c'était déjà le cas.
# Le pré-tri ne supprime JAMAIS rien : il pose un simple avertissement sur la
# vignette dans le vestiaire. Aucune machine ne décide à la place du staff.

# ── Publication depuis le vestiaire (bouton « Publier ») ──
# Le backoffice commite le contenu sur GitHub puis redéclenche le déploiement.
GITHUB_TOKEN=
GITHUB_REPO=Eddy-etame/Bc-st-cyprien
GITHUB_BRANCH=main
VERCEL_DEPLOY_HOOK=
